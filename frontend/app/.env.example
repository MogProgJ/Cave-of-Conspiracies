# Cave of Conspiracies — Frontend Environment

# Base URL for all API calls.
# Default is same-origin /api, which works for both the PHP dev server
# (XAMPP) and the production Apache setup.
VITE_API_BASE_URL=/api

# PHP backend URL for Vite dev server proxy (npm run dev).
# Only needed when running the frontend separately from PHP.
# Default assumes: php -S 0.0.0.0:8080
VITE_PHP_BACKEND=http://localhost:8080

# GEMINI_API_KEY: Required only if you use Gemini AI features.
# In AI Studio this is injected automatically.
GEMINI_API_KEY=
